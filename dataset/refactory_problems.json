        "expected": "False"
      },
      {
        "input": "unique_month(\"January\", ((\"January\",\"1\"),(\"February\",\"1\")))",
        "expected": "True"
      },
      {
        "input": "contains_unique_day(\"January\", ((\"January\",\"1\"),(\"January\",\"2\")))",
        "expected": "True"
      },
      {
        "input": "contains_unique_day(\"January\", ((\"January\",\"1\"),(\"February\",\"1\")))",
        "expected": "False"
      },
      {
        "input": "contains_unique_day(\"February\", ((\"January\",\"10\"),(\"February\",\"1\"),(\"February\",\"10\")))",
        "expected": "True"
      },
      {
        "input": "unique_day(\"3\", ((\"January\",\"1\"),(\"January\",\"2\")))",
        "expected": "False"
      },
      {
        "input": "unique_month(\"March\", ((\"January\",\"1\"),(\"February\",\"1\")))",
        "expected": "False"
      },
      {
        "input": "unique_day(\"1\", ((\"January\",\"1\"),(\"January\",\"2\")))",
        "expected": "True"
      },
      {
        "input": "unique_day(\"16\", tuple_of_possible_birthdays)",
        "expected": "False"
      },
      {
        "input": "unique_day(\"17\", tuple_of_possible_birthdays)",
        "expected": "False"
      },
      {
        "input": "unique_day(\"18\", tuple_of_possible_birthdays)",
        "expected": "True"
      },
      {
        "input": "unique_day(\"19\", tuple_of_possible_birthdays)",
        "expected": "True"
      },
      {
        "input": "unique_month(\"May\", tuple_of_possible_birthdays)",
        "expected": "False"
      },
      {
        "input": "unique_month(\"June\", tuple_of_possible_birthdays)",
        "expected": "False"
      },
      {
        "input": "contains_unique_day(\"June\", tuple_of_possible_birthdays)",
        "expected": "True"
      },
      {
        "input": "contains_unique_day(\"July\", tuple_of_possible_birthdays)",
        "expected": "False"
      }
