# Copy this file to ".env" and fill in your own key. Never share .env or push it to GitHub.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which Gemini model to use. gemini-2.5-flash is closed to new keys; 3.5-flash tested OK on 28 Oct 2026.
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the main model is busy (503) or out of free quota (429).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Our fine-tuned model in Ollama (created with: ollama create beginner-tutor -f Modelfile)
OLLAMA_URL=http://localhost:11434
TUTOR_MODEL=beginner-tutor
